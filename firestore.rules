rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthed() {
      return request.auth != null;
    }

    function userRole() {
      return isAuthed()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function isOwner() {
      return isAuthed() && userRole() == 'owner';
    }

    function canRead() {
      return isAuthed() && userRole() in ['owner', 'accountant'];
    }

    match /users/{userId} {
      // Accountants can read their own profile but cannot write it (MVP scope: owner manages all)
      allow read: if isAuthed() && request.auth.uid == userId;
      allow write: if isOwner() && request.auth.uid == userId;
    }

    match /meta/{doc} {
      allow read: if canRead();
      allow write: if isOwner();
    }

    match /clients/{id} {
      allow read: if canRead();
      allow write: if isOwner();
    }

    match /invoices/{id} {
      allow read: if canRead();
      allow write: if isOwner();
    }

    match /expenses/{id} {
      allow read: if canRead();
      allow write: if isOwner();
    }

    // Deny all access to any collection not explicitly declared above
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
